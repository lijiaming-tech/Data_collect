      "+    // Transition to ABORTED",
      "+    ret = rcl_action_update_goal_state(rcl_handle_.get(), GOAL_EVENT_ABORT);",
      "+    if (RCL_RET_OK != ret) {",
      "+      return false;",
      "+    }",
      "+  }",
      "+",
