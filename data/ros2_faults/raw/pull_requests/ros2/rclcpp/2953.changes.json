      "+{",
      "+  std::lock_guard<std::mutex> lock(rcl_handle_mutex_);",
      "+  rcl_ret_t ret;",
      "+  // Check if the goal is abortable",
      "+  const bool is_abortable = rcl_action_goal_handle_is_abortable(rcl_handle_.get());",
