      "   std::shared_ptr<rclcpp::Executor> exec;",
      "-  std::shared_ptr<rclcpp_components::ComponentManager> node =",
      "-    std::make_shared<rclcpp_components::ComponentManager>();",
      "-  const int64_t num_threads = (node->has_parameter(\"thread_num\")) ?",
