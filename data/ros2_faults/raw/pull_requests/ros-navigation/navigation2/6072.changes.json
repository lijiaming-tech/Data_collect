      "+      min_delta_vx = s.model_dt * s.constraints.ax_min;",
      "+      max_delta_vy = s.model_dt * s.constraints.ay_max;",
      "+      min_delta_vy = s.model_dt * s.constraints.ay_min;",
      "+      max_delta_wz = s.model_dt * s.constraints.az_max;",
