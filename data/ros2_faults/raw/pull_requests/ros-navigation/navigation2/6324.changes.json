      "@@ -14,6 +14,9 @@",
      " ",
      " #include <gtest/gtest.h>",
      " ",
      "+#include <chrono>",
      "+#include <future>",
      "+",
      " #include \"rclcpp/rclcpp.hpp\"",
      " #include \"nav2_costmap_2d/costmap_2d_publisher.hpp\"",
      " #include \"nav2_costmap_2d/costmap_subscriber.hpp\"",
      "@@ -300,6 +303,60 @@ TEST_F(",
